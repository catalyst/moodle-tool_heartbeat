{{!
    @template tool_heartbeat/unmutebutton

    A button to unmute the system check.

    Example context (json):
    {
        "ref": "tool_heartbeat_scheduledqueue",
        "action": "/admin/tool/heartbeat/override.php",
        "sesskey": "AtWNFj5rP7"
    }
}}
<form id="unmuteform-{{ref}}" class="unmuteform d-inline" action="{{{action}}}" method="post">
    <input type="hidden" name="sesskey" value="{{sesskey}}">
    <input type="hidden" name="ref" value="{{ref}}">
    <input type="hidden" name="unmute" value="1">
    <button type="submit" class="btn btn-link p-0" style="display:contents;">{{#str}}unmute, tool_heartbeat{{/str}}</button>
</form>
